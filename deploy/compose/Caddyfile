# deploy/compose/Caddyfile
# HTTPS for DOMAIN with a certificate Caddy obtains and renews itself.
# DOMAIN=localhost gives a certificate from Caddy's own local authority,
# which browsers warn about: fine for a trial, not for users.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The API and its health probe. Server-Sent Events from /api/ask are
	# flushed as they arrive; Caddy does this for text/event-stream itself.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Everything else is the web app (nginx serving static files).
	handle {
		reverse_proxy ui:80
	}
}
