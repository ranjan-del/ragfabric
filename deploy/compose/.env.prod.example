# deploy/compose/.env.prod.example: copy to deploy/compose/.env and fill in.
# .env is ignored by git. Never commit the filled-in copy.

# The public name of this server. Its DNS A/AAAA record must point here before
# the first start, so Caddy can obtain a certificate. localhost for a trial.
DOMAIN=

# Release to run from GHCR (without the v). From a source checkout, use
# `up -d --build` instead and this only names the local images.
RAGFABRIC_VERSION=0.4.0

# Ports Caddy publishes on the host. Keep 80 and 443 for a real domain.
HTTP_PORT=80
HTTPS_PORT=443

# Required. Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET=

# The first admin, created on the first start. Not admin@example.com: production refuses it.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Only for the providers ragfabric.prod.yaml selects. Ollama needs none.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Another ragfabric.yaml instead of ./ragfabric.prod.yaml (path relative to this folder).
# RAGFABRIC_CONFIG_FILE=./ragfabric.prod.yaml

# Host folder the connectors profile watches (mounted at /data/inbox).
INBOX_DIR=./inbox

# Profiles to start with every `up`: ollama, connectors, workers (comma separated).
# COMPOSE_PROFILES=ollama,connectors
